# npm run dev defaults to the in-memory demo; dev:online overrides this flag.
DEMO_MODE=true
DATABASE_URL="mysql://root:123456@localhost:3306/board_game_lobby"
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Set on EVERY instance to enable Redis room storage, locks, timers and adapter.
REDIS_URL=
VITE_SERVER_URL=
# Keep blank to use Vite's same-origin proxy.
